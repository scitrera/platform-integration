+"""Operator gateway settings must never silently downgrade authentication."""
+import pytest
+from scitrera_ai_intelligence.llm.sidecar_projection import _build_llm_virtual_rewrite, _gateway_route
+
+@pytest.fixture(autouse=True)
+def clean_env(monkeypatch):
+    for name in ("LLM_GATEWAY_BASE_URL", "LLM_GATEWAY_AUTH_MODE", "LLM_GATEWAY_BEARER_TOKEN_FILE"):
+        monkeypatch.delenv(name, raising=False)
+
+def test_bearer_projection_preserves_authoritative_attribution(tmp_path, monkeypatch):
+    token=tmp_path/"token"
+    token.write_text("synthetic-gateway-token-for-tests")
+    monkeypatch.setenv("LLM_GATEWAY_BEARER_TOKEN_FILE",str(token))
+    monkeypatch.setenv("LLM_GATEWAY_BASE_URL","https://gateway.example.test/models/v1")
+    rewrite=_build_llm_virtual_rewrite("alpha",user="alice@example.test",source="sahara")
+    route=rewrite["target_route_by_alias"]["sahara-default"]
+    assert route["host"]=="gateway.example.test"
+    assert route["scheme"]=="https"
+    assert route["path_prefix"]=="/models/v1"
+    assert route["headers"]=={"Authorization":"Bearer synthetic-gateway-token-for-tests",
+        "X-Scitrera-Tenant":"alpha","X-Scitrera-User":"alice@example.test","X-Scitrera-Source":"sahara"}
+
+def test_required_bearer_without_file_fails_closed(monkeypatch):
+    monkeypatch.setenv("LLM_GATEWAY_AUTH_MODE","bearer")
+    with pytest.raises(ValueError,match="requires"):_gateway_route()
+
+@pytest.mark.parametrize("value",["ftp://example.test","https://u:p@example.test","https://example.test?token=secret"])
+def test_invalid_gateway_address(value,monkeypatch):
+    monkeypatch.setenv("LLM_GATEWAY_BASE_URL",value)
+    with pytest.raises(ValueError):_gateway_route()
+
+def test_missing_or_empty_token_file_fails_closed(tmp_path,monkeypatch):
+    token=tmp_path/"missing"
+    monkeypatch.setenv("LLM_GATEWAY_BEARER_TOKEN_FILE",str(token))
+    with pytest.raises(FileNotFoundError):_gateway_route()
+    token.write_text("")
+    with pytest.raises(ValueError):_gateway_route()
+
+def test_blob_fetch_allowlist_is_bounded_to_the_configured_route(monkeypatch):
+    import re
+    from scitrera_ai_intelligence.llm.sidecar_projection import _blob_fetch_allowlist
+    monkeypatch.setenv("SANDBOX_BLOB_FETCH_BASE_URL","http://edge.example.test:8090/tenant")
+    pattern=_blob_fetch_allowlist()[0]
+    assert re.match(pattern,"http://edge.example.test:8090/tenant/blob/object?cap=synthetic")
+    for url in ["http://edge.example.test:8090/capabilities",
+                "http://edge.example.test:8090/tenant/revoke",
+                "http://edge.example.test.attacker.test:8090/tenant/blob/object",
+                "https://edge.example.test:8090/tenant/blob/object"]:
+        assert not re.match(pattern,url)
+
+@pytest.mark.parametrize("value",["file:///tmp/store","http://u:p@edge.test","http://edge.test?key=value","http://edge.test#blob","http://edge.test:invalid"])
+def test_invalid_blob_fetch_endpoint_fails_closed(value,monkeypatch):
+    from scitrera_ai_intelligence.llm.sidecar_projection import _blob_fetch_allowlist
+    monkeypatch.setenv("SANDBOX_BLOB_FETCH_BASE_URL",value)
+    with pytest.raises(ValueError):
+        _blob_fetch_allowlist()
