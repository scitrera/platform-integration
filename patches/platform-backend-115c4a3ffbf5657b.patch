@@ -182,17 +182,23 @@ func (c *Client) ConnectToKernel(kernelId string) error {
 		wsURL = fmt.Sprintf("%s?token=%s", wsURL, c.Auth.Token)
 	}
 
-	if err := c.executeClient.Connect(wsURL); err != nil {
-		return err
+	// Do not send user code until the new connection has demonstrated paired
+	// IOPUB delivery. A cold Jupyter connection can stall while the kernel itself
+	// stays healthy; reconnecting is safe here because only readiness probes have
+	// been sent. Never replay user execution to recover a connection.
+	var lastErr error
+	for attempt := 1; attempt <= 3; attempt++ {
+		if err := c.executeClient.Connect(wsURL); err != nil {
+			lastErr = err
+		} else if err := c.executeClient.WaitReady(execdflag.KernelReadyTimeout); err != nil {
+			lastErr = err
+			c.executeClient.Disconnect()
+		} else {
+			return nil
+		}
+		log.Warning("kernel %s connection readiness attempt %d failed", kernelId, attempt)
 	}
-	// Gate on kernel iopub readiness before any execute_request rides this fresh
-	// WS: closes the ZMQ slow-joiner window that silently drops stdout/result on a
-	// cold per-exec reconnect. Non-fatal — the wait alone gives the SUB time to
-	// join, so a timeout just proceeds (best-effort) rather than failing the run.
-	if err := c.executeClient.WaitReady(execdflag.KernelReadyTimeout); err != nil {
-		log.Warning("kernel %s iopub readiness gate: %v (proceeding)", kernelId, err)
-	}
-	return nil
+	return fmt.Errorf("kernel %s connection not ready after 3 attempts: %w", kernelId, lastErr)
 }
 
