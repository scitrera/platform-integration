+def _gateway_route() -> tuple[dict[str, str], str]:
+    """Resolve operator-owned gateway routing; secrets stay in the sidecar.
+
+    A configured token file is required to be readable and nonempty. Its absence
+    never falls back to network trust. Existing network-gated installations retain
+    their default when neither authentication setting is supplied.
+    """
+    route = dict(_BUCKET_UPSTREAM_ROUTES["gateway"])
+    base = os.environ.get("LLM_GATEWAY_BASE_URL", "")
+    if base:
+        parsed = urlsplit(base)
+        if (parsed.scheme not in {"http", "https"} or not parsed.hostname
+                or parsed.username or parsed.password or parsed.query or parsed.fragment):
+            raise ValueError("LLM_GATEWAY_BASE_URL must be an HTTP(S) URL without credentials, query or fragment")
+        route.update(scheme=parsed.scheme, host=parsed.netloc,
+                     path_prefix=parsed.path.rstrip("/") or "/v1")
+    token_file = os.environ.get("LLM_GATEWAY_BEARER_TOKEN_FILE", "")
+    mode = os.environ.get("LLM_GATEWAY_AUTH_MODE", "bearer" if token_file else "trusted_network")
+    if mode not in {"bearer", "trusted_network"}:
+        raise ValueError("LLM_GATEWAY_AUTH_MODE must be bearer or trusted_network")
+    if mode == "trusted_network":
+        if token_file:
+            raise ValueError("Gateway token file conflicts with trusted_network mode")
+        return route, ""
+    if not token_file:
+        raise ValueError("Bearer gateway requires LLM_GATEWAY_BEARER_TOKEN_FILE")
+    token = Path(token_file).read_text().strip()
+    if len(token) < 16 or any(c.isspace() for c in token):
+        raise ValueError("Gateway bearer token must be at least 16 characters without whitespace")
+    return route, token
+
