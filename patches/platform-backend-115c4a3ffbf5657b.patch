diff --git b/backend/scitrera_app_server/provisioning/service_acl_policy.py b/backend/scitrera_app_server/provisioning/service_acl_policy.py
new file mode 100644
index 0000000..d4bf381
--- /dev/null
+++ b/backend/scitrera_app_server/provisioning/service_acl_policy.py
@@ -0,0 +1,145 @@
+"""Opt-in named service baseline for installations with restricted service readers.
+
+The legacy bootstrap grants every service administrative KV access. Selecting
+ACL_TRUSTED_SERVICE_IMPLEMENTATIONS replaces only those inherited grants with
+named implementation grants. Other explicitly provisioned permissions remain.
+"""
+import re
+import json
+
+PREFIX = "Trusted service baseline: "
+
+
+def parse_trusted_services(raw):
+    if raw is None:
+        return None
+    values = list(dict.fromkeys(raw.replace(",", " ").split()))
+    if not values or any(not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}", value) for value in values):
+        raise ValueError("ACL_TRUSTED_SERVICE_IMPLEMENTATIONS requires explicit service names")
+    return values
+
+
+def parse_read_only_services(raw, trusted):
+    if raw is None:
+        return {}
+    if trusted is None:
+        raise ValueError("Read-only services require a named trusted-service policy")
+    readers = json.loads(raw)
+    if not isinstance(readers, dict):
+        raise ValueError("ACL_READ_ONLY_KV_SERVICES must be an object")
+    for name, keys in readers.items():
+        if parse_trusted_services(name) != [name] or name in trusted:
+            raise ValueError("Read-only service must be distinct from trusted services")
+        if not isinstance(keys, list) or not keys or any(
+            not isinstance(key, str) or not key or key.startswith(("*", "?")) for key in keys
+        ):
+            raise ValueError("Read-only service requires bounded KV key patterns")
+    return readers
+
+
+def read_only_service_grants(readers):
+    result = []
+    for name, keys in readers.items():
+        principal = "sv::" + name + "::*"
+        for resource_type, resources in {
+            "kv_scope": ("global", "workspace", "user", "user-workspace"),
+            "admin": ("admin/*",),
+            "capability": ("capability/*",),
+            "workspace": ("*",),
+            "service_impl": ("*",),
+        }.items():
+            result.extend(("service", principal, resource_type, resource, 0,
+                           PREFIX + "read-only service default deny") for resource in resources)
+        result.extend(("service", principal, "kv_key", key, 10,
+                       PREFIX + "read-only KV key") for key in keys)
+    return result
+
+
+def restrict_service_grants(grants, trusted):
+    if trusted is None:
+        return grants
+    result = []
+    for ptype, pid, rtype, rid, level, reason in grants:
+        if (ptype, pid) == ("wildcard", "_any_service"):
+            result.extend(("service", "sv::" + name + "::*", rtype, rid, level, PREFIX + reason)
+                          for name in trusted)
+        else:
+            result.append((ptype, pid, rtype, rid, level, reason))
+    # Several named services already have a more specific grant for the same
+    # tuple. The legacy wildcard won over those globs. Preserve its effective
+    # maximum when replacing it; repeated upserts must not lower that level.
+    merged = {}
+    for grant in result:
+        key = grant[:4]
+        if key not in merged or grant[4] > merged[key][4]:
+            merged[key] = grant
+    return list(merged.values())
+
+
+def _require(response, action):
+    if response is None or not getattr(response, "success", False):
+        raise RuntimeError("Service ACL policy could not confirm " + action)
+    return response
+
+
+async def reconcile_service_policy(admin, desired, granted_by):
+    """Verify replacement grants before retiring obsolete bootstrap-owned rules.
+
+    An unknown broad grant fails the job for explicit operator review. It is not
+    silently removed. Read-back after retirement makes partial failures retryable.
+    """
+    expected = {(g[0], g[1], g[2], g[3]): g[4] for g in desired if g[5].startswith(PREFIX)}
+    # The expected set is bounded by the installation's explicit service list.
+    for (ptype, pid, rtype, rid), level in expected.items():
+        response = _require(await admin.list_acl_rules(principal_type=ptype, principal_id=pid,
+                            resource_type=rtype, resource_id=rid, limit=2), "replacement grant")
+        if len(response.rules) != 1 or response.rules[0].access_level != level:
+            raise RuntimeError("Service ACL replacement grant read-back mismatch: " +
+                               repr((ptype, pid, rtype, rid, level, [r.access_level for r in response.rules])))
+    obsolete = []
+    # Aether's ACL RPC returns the complete filtered inventory; its current
+    # server ignores the protocol's limit/offset fields. Do not emulate paging.
+    response = _require(await admin.list_acl_rules(), "rule inventory")
+    if len(response.rules) > 10000:
+        raise RuntimeError("Service ACL inventory exceeds the bounded migration limit")
+    for rule in response.rules:
+        broad = (rule.principal_type, rule.principal_id) == ("wildcard", "_any_service")
+        owned = rule.granted_by == granted_by
+        key = (rule.principal_type, rule.principal_id, rule.resource_type, rule.resource_id)
+        stale = rule.reason.startswith(PREFIX) and key not in expected
+        if broad and not owned:
+            raise RuntimeError("Non-bootstrap wildcard service grant requires operator review")
+        if broad or (owned and stale):
+            obsolete.append(rule)
+    for rule in obsolete:
+        _require(await admin.delete_acl_rule(rule.rule_id), "obsolete grant removal")
+    remaining = _require(await admin.list_acl_rules(principal_type="wildcard",
+                         principal_id="_any_service", limit=1), "wildcard retirement")
+    if remaining.rules:
+        raise RuntimeError("Broad service grant remains after reconciliation")
+
+
+def parse_configured_service_grants(raw):
+    """Read explicitly selected deployment grants; no defaults or blanket subjects."""
+    if raw is None:
+        return []
+    rows = json.loads(raw)
+    if not isinstance(rows, list) or len(rows) > 128:
+        raise ValueError("ACL_SERVICE_GRANTS must be a bounded list")
+    result = []
+    for row in rows:
+        if not isinstance(row, dict) or set(row) != {"principal_id", "resource_type", "resource_id", "access_level"}:
+            raise ValueError("ACL_SERVICE_GRANTS row has invalid fields")
+        if not isinstance(row["principal_id"], str) or not re.fullmatch(
+            r"sv::[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}::[a-zA-Z0-9_.*-]+", row["principal_id"]
+        ):
+            raise ValueError("Configured grant must name a concrete service implementation")
+        if row["resource_type"] not in {"capability", "service_impl", "workspace", "kv_key"}:
+            raise ValueError("Unsupported configured service resource type")
+        if not isinstance(row["resource_id"], str) or not row["resource_id"] or row["resource_id"].startswith(("*", "?")):
+            raise ValueError("Configured grant requires a bounded resource")
+        if type(row["access_level"]) is not int or row["access_level"] not in {0, 10, 20, 30}:
+            raise ValueError("Configured service grant cannot exceed MANAGE")
+        result.append(("service", row["principal_id"], row["resource_type"], row["resource_id"],
+                       row["access_level"], PREFIX + "explicit deployment grant"))
+    return result
