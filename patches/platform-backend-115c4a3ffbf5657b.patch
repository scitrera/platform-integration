diff --git b/sandbox-provider/internal/provider/docker/reconcile_creation_test.go b/sandbox-provider/internal/provider/docker/reconcile_creation_test.go
new file mode 100644
index 0000000..1235c72
--- /dev/null
+++ b/sandbox-provider/internal/provider/docker/reconcile_creation_test.go
@@ -0,0 +1,124 @@
+package docker
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/docker/docker/api/types/container"
+	dockerclient "github.com/docker/docker/client"
+	"github.com/scitrera/platform-backend/sandbox-provider/internal/provider"
+	"github.com/scitrera/platform-backend/sandbox-provider/internal/provider/sidecar"
+	"github.com/scitrera/platform-backend/sandbox-provider/internal/state"
+)
+
+// A running Create has created its Docker container but has not yet returned
+// a ready handle or persisted the KV record. Reconcile must leave it alone.
+func TestReconcilePreservesCreationInProgress(t *testing.T) {
+	var removals atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/containers/json"):
+			_ = json.NewEncoder(w).Encode([]container.Summary{{ID: "synthetic-starting", Labels: map[string]string{
+				labelSandboxID: "starting", labelRole: "sandbox", labelThreadID: "user:synthetic", labelTenantID: "alpha",
+			}}})
+		case r.Method == http.MethodDelete:
+			removals.Add(1)
+			w.WriteHeader(http.StatusNoContent)
+		case strings.HasSuffix(r.URL.Path, "/networks"):
+			_, _ = w.Write([]byte("[]"))
+		default:
+			t.Errorf("unexpected Docker request: %s %s", r.Method, r.URL.Path)
+			w.WriteHeader(http.StatusNotFound)
+		}
