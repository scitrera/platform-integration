@@ -0,0 +1,82 @@
+package config
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestAetherTLSLoadsDistinctServiceAndAnonymousUserCredentials(t *testing.T) {
+	dir := t.TempDir()
+	public, key, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ca := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "fixture CA"},
+		NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour),
+		IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign}
+	der, err := x509.CreateCertificate(rand.Reader, ca, ca, public, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caPath := filepath.Join(dir, "ca.crt")
+	if err := os.WriteFile(caPath, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("AETHER_TLS_ENABLED", "true")
+	t.Setenv("AETHER_TLS_CA_CERT", caPath)
+	for i, role := range []string{"service", "user"} {
+		cn := "sv::tools-wss-client::fixture"
+		prefix := "AETHER_TLS_CLIENT_"
+		if role == "user" {
+			cn = "_anonymous"
+			prefix = "AETHER_USER_TLS_CLIENT_"
+		}
+		pub, priv, err := ed25519.GenerateKey(rand.Reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		leaf := &x509.Certificate{SerialNumber: big.NewInt(int64(i + 2)), Subject: pkix.Name{CommonName: cn},
+			NotBefore: ca.NotBefore, NotAfter: ca.NotAfter, KeyUsage: x509.KeyUsageDigitalSignature,
+			ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth}}
+		cert, err := x509.CreateCertificate(rand.Reader, leaf, ca, pub, key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		pkcs, err := x509.MarshalPKCS8PrivateKey(priv)
+		if err != nil {
+			t.Fatal(err)
+		}
+		certPath, keyPath := filepath.Join(dir, role+".crt"), filepath.Join(dir, role+".key")
+		if err := os.WriteFile(certPath, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: cert}), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(keyPath, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: pkcs}), 0600); err != nil {
+			t.Fatal(err)
+		}
+		t.Setenv(prefix+"CERT", certPath)
+		t.Setenv(prefix+"KEY", keyPath)
+	}
+	service, user, err := loadAetherTLS()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !service.Enabled || !user.Enabled || string(service.ClientCert) == string(user.ClientCert) {
+		t.Fatal("service and user TLS identities were not distinct")
+	}
+	t.Setenv("AETHER_USER_TLS_CLIENT_KEY", "")
+	if _, _, err := loadAetherTLS(); err == nil {
+		t.Fatal("missing user key accepted")
+	}
+	t.Setenv("AETHER_TLS_ENABLED", "maybe")
+	if _, _, err := loadAetherTLS(); err == nil {
+		t.Fatal("invalid TLS switch accepted")
+	}
+}
