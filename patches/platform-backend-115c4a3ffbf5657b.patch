+func TestFailedAllocationConnectsNetworkBeforeStartAndCleansPeers(t *testing.T) {
+	attached := false
+	started := false
+	removed := map[string]bool{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/networks/create"):
+			_, _ = w.Write([]byte("{\"Id\":\"network\"}"))
+		case strings.HasSuffix(r.URL.Path, "/containers/create"):
+			_, _ = w.Write([]byte("{\"Id\":\"sidecar\"}"))
+		case strings.HasSuffix(r.URL.Path, "/connect"):
+			if strings.Contains(r.URL.Path, "/tenant-alpha/") {
+				attached = true
+			}
+			w.WriteHeader(http.StatusOK)
+		case strings.HasSuffix(r.URL.Path, "/start"):
+			started = true
+			if !attached {
+				t.Error("relay started before its Aether network was attached")
+			}
+			w.WriteHeader(http.StatusInternalServerError)
+			_, _ = w.Write([]byte("{\"message\":\"synthetic failed start\"}"))
+		case r.Method == http.MethodDelete:
+			removed[r.URL.Path] = true
+			w.WriteHeader(http.StatusNoContent)
+		default:
+			t.Errorf("unexpected Docker request: %s %s", r.Method, r.URL.Path)
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	defer server.Close()
+	client, err := dockerclient.NewClientWithOpts(dockerclient.WithHost(server.URL), dockerclient.WithVersion("1.47"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	p := &Provider{docker: client, cfg: ProviderConfig{
+		DataDir: t.TempDir(), SidecarCfg: sidecar.SandboxSidecarConfig{Enabled: true, Image: "synthetic-sidecar", AetherNetwork: "tenant-alpha"},
+	}}
+	_, _, err = p.createContainer(context.Background(), createContainerInput{
+		sandboxID: "123456789012-rest", ownerKey: "user:synthetic", image: "sahara:fixture",
+		sidecarIdentity: &sidecar.SidecarIdentity{},
+	})
+	if err == nil || !started {
+		t.Fatalf("expected injected startup failure: %v", err)
+	}
+	for _, suffix := range []string{"/containers/scitrera-sidecar-123456789012", "/networks/scitrera-sandbox-net-123456789012", "/networks/scitrera-egress-net-123456789012"} {
+		found := false
+		for path := range removed {
+			if strings.HasSuffix(path, suffix) {
+				found = true
+			}
+		}
+		if !found {
+			t.Errorf("failed allocation retained %s", suffix)
+		}
+	}
+}
