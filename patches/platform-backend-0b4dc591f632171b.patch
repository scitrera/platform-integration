--- /dev/null
+++ b/tools-wss/internal/config/tls.go
@@ -0,0 +1,63 @@
+package config
+
+import (
+	"fmt"
+	aether "github.com/scitrera/aether/sdk/go/aether"
+	"os"
+	"strconv"
+)
+
+// loadAetherTLS keeps the named service and anonymous user certificates separate.
+func loadAetherTLS() (*aether.TLSConfig, *aether.TLSConfig, error) {
+	raw := os.Getenv("AETHER_TLS_ENABLED")
+	if raw == "" {
+		raw = "false"
+	}
+	enabled, err := strconv.ParseBool(raw)
+	if err != nil {
+		return nil, nil, fmt.Errorf("AETHER_TLS_ENABLED must be a boolean")
+	}
+	if !enabled {
+		return nil, nil, nil
+	}
+	read := func(name string) ([]byte, error) {
+		path := os.Getenv(name)
+		if path == "" {
+			return nil, fmt.Errorf("%s is required with Aether TLS", name)
+		}
+		value, err := os.ReadFile(path)
+		if err != nil {
+			return nil, fmt.Errorf("read %s: %w", name, err)
+		}
+		return value, nil
+	}
+	roots, err := read("AETHER_TLS_CA_CERT")
+	if err != nil {
+		return nil, nil, err
+	}
+	leaf := func(certName, keyName string) (*aether.TLSConfig, error) {
+		cert, err := read(certName)
+		if err != nil {
+			return nil, err
+		}
+		key, err := read(keyName)
+		if err != nil {
+			return nil, err
+		}
+		cfg := &aether.TLSConfig{Enabled: true, RootCAs: roots, ClientCert: cert, ClientKey: key,
+			ServerName: os.Getenv("AETHER_TLS_SERVER_NAME")}
+		if _, err := cfg.ToTLSConfig(); err != nil {
+			return nil, fmt.Errorf("invalid %s configuration: %w", certName, err)
+		}
+		return cfg, nil
+	}
+	service, err := leaf("AETHER_TLS_CLIENT_CERT", "AETHER_TLS_CLIENT_KEY")
+	if err != nil {
+		return nil, nil, err
+	}
+	user, err := leaf("AETHER_USER_TLS_CLIENT_CERT", "AETHER_USER_TLS_CLIENT_KEY")
+	if err != nil {
+		return nil, nil, err
+	}
+	return service, user, nil
+}
