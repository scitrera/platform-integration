+// A running Create has created its Docker container but has not yet returned
+// a ready handle or persisted the KV record. Reconcile must leave it alone.
+func TestReconcilePreservesCreationInProgress(t *testing.T) {
+	var removals atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/containers/json"):
+			_ = json.NewEncoder(w).Encode([]container.Summary{{ID: "synthetic-starting", Labels: map[string]string{
+				labelSandboxID: "starting", labelRole: "sandbox", labelThreadID: "user:synthetic", labelTenantID: "alpha",
+			}}})
+		case r.Method == http.MethodDelete:
+			removals.Add(1)
+			w.WriteHeader(http.StatusNoContent)
+		case strings.HasSuffix(r.URL.Path, "/networks"):
+			_, _ = w.Write([]byte("[]"))
+		default:
+			t.Errorf("unexpected Docker request: %s %s", r.Method, r.URL.Path)
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	defer server.Close()
+	client, err := dockerclient.NewClientWithOpts(dockerclient.WithHost(server.URL), dockerclient.WithVersion("1.47"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	p := &Provider{docker: client, sandboxes: map[string]*sandboxRecord{}}
+	lock := p.lockForOwner("user:synthetic")
+	lock.Lock()
+	defer lock.Unlock()
+	if err := p.Reconcile(context.Background(), provider.ReconcileScope{TenantID: "alpha", KV: state.NewMemoryKV()}); err != nil {
+		t.Fatal(err)
+	}
+	if removals.Load() != 0 {
+		t.Fatalf("reconcile removed %d resources during Create", removals.Load())
+	}
+}
