+// SPDX-License-Identifier: AGPL-3.0-only
+
+package app
+
+import (
+	"bufio"
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/scitrera/platform-backend/sandbox/images/sandbox-sidecar2/internal/proxy"
+)
+
+func TestForwardEventStreamFlushesScrubbedRecordAndPropagatesCancellation(t *testing.T) {
+	upstreamCancelled := make(chan struct{})
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream; charset=utf-8")
+		// Deliberately split a secret and a JSON credential field across reads.
+		for _, fragment := range []string{
+			"data: {\"text\":\"synthetic-",
+			"secret-value\",\"api_key\":\"another-secret-value\"}\n\n",
+		} {
+			_, _ = io.WriteString(w, fragment)
+			w.(http.Flusher).Flush()
+		}
+		<-r.Context().Done()
+		close(upstreamCancelled)
+	}))
+	defer upstream.Close()
+	u, _ := url.Parse(upstream.URL)
+	port, _ := strconv.Atoi(u.Port())
+	adapter := proxyAdapter{client: upstream.Client()}
+	forward := proxyForward{next: proxy.Request{Scheme: "http", Host: u.Hostname(), Port: port, Path: "/", Headers: http.Header{}},
+		cfg: proxy.Config{ScrubValues: []string{"synthetic-secret-value"}}}
+	downstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		adapter.forwardHTTP(w, r, forward)
+	}))
+	defer downstream.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	request, _ := http.NewRequestWithContext(ctx, "GET", downstream.URL, nil)
+	response, err := downstream.Client().Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	line, err := bufio.NewReader(response.Body).ReadString('\n')
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(line, "secret") || strings.Count(line, "[REDACTED]") != 2 {
+		t.Fatalf("streaming credential filtering failed: %q", line)
+	}
+	if response.Header.Get("Content-Length") != "" {
+		t.Fatal("stream retained a content length")
+	}
+	cancel()
+	_ = response.Body.Close()
+	select {
+	case <-upstreamCancelled:
+	case <-time.After(2 * time.Second):
+		t.Fatal("downstream cancellation did not reach upstream")
+	}
+}
+
+func TestForwardEventStreamRejectsEncodedInputBeforeSendingHeaders(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	response := &http.Response{StatusCode: 200, Header: http.Header{"Content-Encoding": []string{"gzip"}}, Body: io.NopCloser(strings.NewReader("encoded"))}
+	proxyAdapter{}.forwardEventStream(recorder, context.Background(), response, proxyForward{}, usageCapture{})
+	if recorder.Code != http.StatusBadGateway {
+		t.Fatalf("status=%d", recorder.Code)
+	}
+	if strings.Contains(recorder.Body.String(), "encoded\"") {
+		t.Fatal("encoded body leaked")
+	}
+}
+
+func TestForwardEventStreamPreservesFrameBoundaries(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	body := "data: one\r\n\r\ndata: two\n\ndata: [DONE]\n\n"
+	response := &http.Response{StatusCode: 200, Header: http.Header{}, Body: io.NopCloser(strings.NewReader(body))}
+	proxyAdapter{}.forwardEventStream(recorder, context.Background(), response, proxyForward{}, usageCapture{})
+	if recorder.Body.String() != strings.ReplaceAll(body, "\r\n", "\n") {
+		t.Fatalf("SSE framing changed: %q", recorder.Body.String())
+	}
+	if !recorder.Flushed {
+		t.Fatal("event stream was never flushed")
+	}
+}
