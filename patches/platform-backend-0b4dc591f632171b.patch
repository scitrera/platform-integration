+		t.Fatalf("expected injected startup failure: %v", err)
+	}
+	for _, suffix := range []string{"/containers/scitrera-sidecar-123456789012", "/networks/scitrera-sandbox-net-123456789012", "/networks/scitrera-egress-net-123456789012"} {
+		found := false
+		for path := range removed {
+			if strings.HasSuffix(path, suffix) {
