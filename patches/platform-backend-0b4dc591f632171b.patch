new file mode 100644
index 0000000..3519344
--- /dev/null
+++ b/sandbox/images/sandbox-sidecar2/internal/app/proxy_stream.go
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+package app
+
+import (
+	"bufio"
+	"context"
+	"io"
+	"net/http"
+
+	"github.com/scitrera/platform-backend/sandbox/images/sandbox-sidecar2/internal/proxy"
+	"github.com/scitrera/platform-backend/sandbox/images/sandbox-sidecar2/internal/usage"
+)
+
+// forwardEventStream scrubs whole SSE records before flushing them. Reading
+// complete records protects credential fields split across transport reads,
+// without waiting for the model to finish. Both record and usage buffers are
+// bounded; oversized records and transport errors terminate the stream.
+func (p proxyAdapter) forwardEventStream(w http.ResponseWriter, ctx context.Context, resp *http.Response, forward proxyForward, capture usageCapture) {
+	if encoding := unsupportedContentEncoding(resp.Header); encoding != "" {
+		writeProxyJSON(w, http.StatusBadGateway, map[string]any{"ok": false, "error": "unsupported encoded text response", "encoding": encoding})
+		return
+	}
+	copyHeaders(w.Header(), resp.Header)
+	stripHopHeaders(w.Header())
+	w.Header().Del("Content-Length")
+	w.WriteHeader(resp.StatusCode)
+	controller := http.NewResponseController(w)
+	scanner := bufio.NewScanner(resp.Body)
+	scanner.Buffer(make([]byte, 4096), maxBufferedTextResponse)
+	var record, captured []byte
+	captureComplete := true
+	flush := func() bool {
+		if len(record) == 0 {
+			return true
+		}
+		scrubbed, _ := proxy.ScrubResponse("text/event-stream", string(record), forward.cfg)
+		if _, err := io.WriteString(w, scrubbed); err != nil {
+			return false
+		}
+		if err := controller.Flush(); err != nil {
+			return false
+		}
+		if capture.matched && captureComplete {
+			if len(captured)+len(record) <= maxBufferedTextResponse {
+				captured = append(captured, record...)
+			} else {
+				// Never submit truncated usage as a complete provider response.
+				captured = nil
+				captureComplete = false
+			}
+		}
+		record = record[:0]
+		return true
+	}
+	for scanner.Scan() {
+		line := scanner.Bytes()
+		if len(record)+len(line)+1 > maxBufferedTextResponse {
+			return
+		}
+		record = append(record, line...)
+		record = append(record, '\n')
+		if len(line) == 0 && !flush() {
+			return
+		}
+	}
+	if scanner.Err() != nil || ctx.Err() != nil {
+		return
+	}
+	if !flush() {
+		return
+	}
+	if captureComplete {
+		capture.recordDetached(ctx, usage.Response{StatusCode: resp.StatusCode, ContentType: "text/event-stream", Body: captured})
+	}
+}
