+// Ranking affects presentation only. Discovery and invocation still use the
+// catalog's checked context, exact references and resolved authority.
+func catalogRelevance(descriptor tools.Descriptor, query string) int {
+	query = strings.ToLower(query)
+	name := strings.ToLower(descriptor.Name)
+	score := 0
+	terms := strings.FieldsFunc(query, func(r rune) bool {
+		return !unicode.IsLetter(r) && !unicode.IsDigit(r) && r != '_'
+	})
+	seen := make(map[string]bool)
+	haystack := name + " " + strings.ToLower(descriptor.Description)
+	for _, term := range terms {
+		if seen[term] {
+			continue
+		}
+		seen[term] = true
+		if term == name {
+			score += 1000
+		}
+		if len(term) >= 3 && strings.Contains(haystack, term) {
+			score++
+		}
+	}
+	return score
+}
