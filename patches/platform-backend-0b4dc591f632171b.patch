@@ -0,0 +1,61 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/scitrera/agent-harness-go/pkg/provider"
+	"github.com/scitrera/platform-backend/agent-harness/sahara/config"
+)
+
+func TestPlatformProviderDrainsTrailingStreamUsage(t *testing.T) {
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Host != "llm.local" {
+			t.Errorf("unexpected virtual host: %s", r.URL.Host)
+		}
+		var body struct {
+			Stream  bool `json:"stream"`
+			Options struct {
+				IncludeUsage bool `json:"include_usage"`
+			} `json:"stream_options"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+			return
+		}
+		if !body.Stream || !body.Options.IncludeUsage {
+			t.Error("stream usage was not requested")
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprint(w, "data: {\"model\":\"fixture\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"fixture\"},\"finish_reason\":\"stop\"}]}\n\n")
+		w.(http.Flusher).Flush()
+		time.Sleep(25 * time.Millisecond)
+		fmt.Fprint(w, "data: {\"model\":\"fixture\",\"choices\":[],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":4,\"total_tokens\":14}}\n\ndata: [DONE]\n\n")
+	}))
+	defer proxy.Close()
+	proxyURL, _ := url.Parse(proxy.URL)
+	original := http.DefaultTransport
+	transport := original.(*http.Transport).Clone()
+	transport.Proxy = http.ProxyURL(proxyURL)
+	http.DefaultTransport = transport
+	t.Cleanup(func() { transport.CloseIdleConnections(); http.DefaultTransport = original })
+	client, err := buildProvider(config.Config{LLMBaseURL: "http://llm.local"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	result, err := client.ChatStream(ctx, provider.ChatRequest{Model: "sahara-default"}, func(provider.DeltaKind, string) error { return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Usage.PromptTokens != 10 || result.Usage.CompletionTokens != 4 || result.Usage.TotalTokens != 14 {
+		t.Fatalf("trailing usage lost: %+v", result.Usage)
+	}
+}
