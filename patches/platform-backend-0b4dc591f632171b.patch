diff --git a/sandbox/components/execd/pkg/jupyter/readiness_test.go b/sandbox/components/execd/pkg/jupyter/readiness_test.go
new file mode 100644
index 0000000..598fad4
--- /dev/null
+++ b/sandbox/components/execd/pkg/jupyter/readiness_test.go
@@ -0,0 +1,81 @@
+package jupyter
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	execdflag "github.com/alibaba/opensandbox/execd/pkg/flag"
+	"github.com/alibaba/opensandbox/execd/pkg/jupyter/execute"
+	"github.com/gorilla/websocket"
+	"github.com/stretchr/testify/require"
+)
+
+func TestConnectToKernelRetriesBeforeExecution(t *testing.T) {
+	previous := execdflag.KernelReadyTimeout
+	execdflag.KernelReadyTimeout = 50 * time.Millisecond
+	defer func() { execdflag.KernelReadyTimeout = previous }()
+	var connections, executions atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		number := connections.Add(1)
+		for {
+			var req execute.Message
+			if conn.ReadJSON(&req) != nil {
+				return
+			}
+			if req.Header.MessageType != "kernel_info_request" {
+				executions.Add(1)
+			}
+			if number == 1 {
+				continue
+			} // The first connection never delivers readiness.
+			_ = conn.WriteJSON(execute.Message{
+				Header: execute.Header{MessageType: "status"}, ParentHeader: req.Header,
+				Channel: "iopub", Content: []byte("{\"execution_state\":\"idle\"}"),
+			})
+		}
+	}))
+	defer server.Close()
+	client := NewClient(server.URL)
+	require.NoError(t, client.ConnectToKernel("cold"))
+	defer client.DisconnectFromKernel("cold")
+	require.EqualValues(t, 2, connections.Load())
+	require.Zero(t, executions.Load(), "readiness recovery must never execute user code")
+}
+
+func TestConnectToKernelRefusesUnreadyConnection(t *testing.T) {
+	previous := execdflag.KernelReadyTimeout
+	execdflag.KernelReadyTimeout = 20 * time.Millisecond
+	defer func() { execdflag.KernelReadyTimeout = previous }()
+	var connections, executions atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		connections.Add(1)
+		for {
+			var req execute.Message
+			if conn.ReadJSON(&req) != nil {
+				return
+			}
+			if req.Header.MessageType != "kernel_info_request" {
+				executions.Add(1)
+			}
+		}
+	}))
+	defer server.Close()
+	client := NewClient(server.URL)
+	require.ErrorContains(t, client.ConnectToKernel("unready"), "not ready after 3 attempts")
+	require.False(t, client.IsConnected())
+	require.EqualValues(t, 3, connections.Load())
+	require.Zero(t, executions.Load())
+}
