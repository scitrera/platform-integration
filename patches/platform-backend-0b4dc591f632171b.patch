+"""Recent history must not fall off the first page of a long thread."""
+from contextlib import asynccontextmanager
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+import pytest
+from scitrera_app_server.tenant_api.tenant_interface2 import TenantInterface2
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("user_scoped", [False, True])
+@pytest.mark.parametrize("exclude_current", [False, True])
+async def test_history_pages_newest_messages_then_returns_chronological_order(user_scoped, exclude_current):
+    stored=[{"id":str(i),"role":"user" if i==5 else "assistant","message":{"text":str(i)}} for i in range(1,6)]
+    async def page(*args, limit, order, **kwargs):
+        assert order=="desc"
+        return list(reversed(stored))[:limit]
+    ml=SimpleNamespace(get_thread_messages=AsyncMock(side_effect=page),get_messages=AsyncMock(side_effect=page))
+    @asynccontextmanager
+    async def request():
+        yield ml
+    ti=object.__new__(TenantInterface2)
+    ti._ml_for_request=request
+    current=SimpleNamespace(content=SimpleNamespace(text="5"))
+    got=await ti.get_chat_history("alice","default",app_or_thread="_default",limit=2,
+                                 user_scoped=user_scoped,msg=current,exclude_current=exclude_current)
+    assert [row["id"] for row in got]==(["3","4"] if exclude_current else ["4","5"])
+    selected=ml.get_thread_messages if user_scoped else ml.get_messages
+    selected.assert_awaited_once()
