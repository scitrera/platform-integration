+from types import SimpleNamespace as NS
+from unittest.mock import AsyncMock
+import pytest
+from scitrera_app_server.provisioning.acl_seed import _build_grants
+from scitrera_app_server.provisioning.service_acl_policy import (
+    PREFIX, parse_trusted_services, reconcile_service_policy,
+)
+
+
+def test_named_policy_has_no_inherited_permission_for_unlisted_services():
+    legacy = _build_grants("fixture", "")
+    restricted = _build_grants("fixture", "", trusted_service_implementations=["memorylayer", "platform-server"])
+    assert any(g[1] == "_any_service" for g in legacy)
+    assert not any(g[1] == "_any_service" for g in restricted)
+    assert {g[1] for g in restricted if g[5].startswith(PREFIX)} == {
+        "sv::memorylayer::*", "sv::platform-server::*"}
+    levels = {g[:4]: g[4] for g in restricted}
+    assert all(levels[g[:4]] >= g[4] for g in legacy if g[1] != "_any_service")
+
+
+@pytest.mark.parametrize("raw", ["", "*", "memorylayer,sv::reader::*", "../reader"])
+def test_names_fail_closed(raw):
+    with pytest.raises(ValueError):
+        parse_trusted_services(raw)
+
+
+@pytest.mark.asyncio
+async def test_reconcile_verifies_replacements_before_removing_broad_grants():
+    desired = [("service", "sv::memorylayer::*", "kv_scope", "global", 40, PREFIX + "kv")]
+    old = NS(principal_type="wildcard", principal_id="_any_service", resource_type="kv_scope",
+             resource_id="global", granted_by="bootstrap", reason="legacy", rule_id="old")
+    admin = NS(list_acl_rules=AsyncMock(side_effect=[
+        NS(success=True, rules=[NS(access_level=40)]), NS(success=True, rules=[old]),
+        NS(success=True, rules=[])]), delete_acl_rule=AsyncMock(return_value=NS(success=True)))
+    await reconcile_service_policy(admin, desired, "bootstrap")
+    admin.delete_acl_rule.assert_awaited_once_with("old")
+
+
+@pytest.mark.asyncio
+async def test_reconcile_preserves_operator_broad_grant_and_reports_failure():
+    old = NS(principal_type="wildcard", principal_id="_any_service", resource_type="kv_scope",
+             resource_id="global", granted_by="operator", reason="custom", rule_id="old")
