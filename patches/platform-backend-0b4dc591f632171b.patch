@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: Apache-2.0
+package multimodal
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	sdk "github.com/scitrera/aether/sdk/go/aether"
+	"github.com/scitrera/agent-harness-go/pkg/protocol"
+)
+
+type uploadRouteProxy struct {
+	public, internal string
+	finalized        bool
+}
+
+func (p *uploadRouteProxy) ProxyHTTP(_ context.Context, _ string, req *http.Request, _ ...sdk.ProxyOpt) (*http.Response, error) {
+	if req.URL.Path == "/v1/urls/upload" {
+		return jsonResp(200, mustJSON(map[string]string{"upload_url": p.public, "upload_internal_url": p.internal, "vfs_ref": "vfs_fixture"})), nil
+	}
+	p.finalized = true
+	return jsonResp(200, []byte("{}")), nil
+}
+
+func TestUploaderUsesConfiguredInternalRouteAndPreservesSignedRequest(t *testing.T) {
+	for _, internal := range []bool{false, true} {
+		t.Run(map[bool]string{false: "public fallback", true: "internal proxy"}[internal], func(t *testing.T) {
+			received := false
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, _ := io.ReadAll(r.Body)
+				if r.Method != "PUT" || r.URL.EscapedPath() != "/uploads/a%2Fb" || r.URL.RawQuery != "sig=a%2Fb&x=1" || string(body) != "artifact bytes" {
+					t.Errorf("signed upload changed: %s %s %s", r.Method, r.URL, string(body))
+				}
+				received = true
+			}))
+			defer server.Close()
+			proxy := &uploadRouteProxy{public: server.URL + "/uploads/a%2Fb?sig=a%2Fb&x=1"}
+			if internal {
+				proxy.internal = proxy.public
+				proxy.public = "http://browser.invalid/unreachable"
+			}
+			uploader, err := NewUploader(UploaderConfig{Proxy: proxy})
+			if err != nil {
+				t.Fatal(err)
+			}
+			ref, err := uploader.Upload(context.Background(), protocol.MessageAddress{WorkspaceID: "fixture"}, "result.txt", "text/plain", []byte("artifact bytes"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if ref != "vfs_fixture" || !received || !proxy.finalized {
+				t.Fatal("upload did not persist")
+			}
+		})
+	}
+}
