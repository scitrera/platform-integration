{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "development": {
      "type": "boolean"
    },
    "image": {
      "type": "string"
    },
    "instances": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "size"
      ],
      "properties": {
        "className": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Gi|Mi)$"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccountAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "maxConnections": {
      "type": "integer",
      "minimum": 10,
      "maximum": 1000
    },
    "databases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "secret"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "secret": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    },
    "memorylayerExtensions": {
      "type": "boolean"
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "type": "string"
        },
        "destinationPath": {
          "type": "string"
        },
        "endpointURL": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "credentialsSecret": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "inheritFromIAMRole": {
          "type": "boolean"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "requirePodAntiAffinity": {
      "type": "boolean"
    }
  }
}
