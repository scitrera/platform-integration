{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bootstrapRevision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
    },
    "tenant": {
      "type": "string"
    },
    "publicOrigin": {
      "type": "string"
    },
    "adminOrigin": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    },
    "tlsSecret": {
      "type": "string"
    },
    "gatewayClass": {
      "type": "string"
    },
    "dnsResolver": {
      "type": "string"
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "development": {
      "type": "boolean"
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "secrets": {
      "type": "object"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "size",
        "className"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Gi|Ti)$"
        },
        "className": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "databaseInstances": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "tenants": {
      "type": "array"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "storageEdgeEndpoint": {
      "type": "string",
      "pattern": "^https?://"
    },
    "uploadProxy": {
      "type": "object",
      "required": [
        "enabled",
        "endpoint",
        "signedHost"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "signedHost": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "storageNamespace": {
      "type": "string",
      "minLength": 1
    },
    "databaseResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "roleResources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requests": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "modelCatalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "addressTemplate": {
          "type": "string"
        },
        "serverNameTemplate": {
          "type": "string"
        },
        "allowedProviderHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "credentialSecretNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowHTTP": {
          "type": "boolean"
        },
        "apiEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "port"
            ],
            "properties": {
              "cidr": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "allowedCredentialSchemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "file",
              "k8s",
              "workload"
            ]
          }
        }
      }
    },
    "existingClaims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "boolean"
        },
        "gateway": {
          "type": "boolean"
        },
        "web": {
          "type": "boolean"
        }
      }
    },
    "managedDatabases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "boolean"
        },
        "gateway": {
          "type": "boolean"
        }
      }
    },
    "authEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify": {
          "type": "string"
        },
        "external": {
          "type": "string"
        }
      }
    },
    "authSession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cookieDomain": {
          "type": "string"
        },
        "defaultTenant": {
          "type": "string"
        },
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ttl": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        },
        "sentinel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "master": {
              "type": "string"
            },
            "addresses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "master",
            "addresses"
          ]
        },
        "genericAppOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "createGateway": {
          "type": "boolean"
        },
        "parentName": {
          "type": "string"
        },
        "parentNamespace": {
          "type": "string"
        },
        "sectionName": {
          "type": "string"
        },
        "hostAuth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "tenant": {
              "type": "string"
            },
            "workspace": {
              "type": "string"
            },
            "loginOrigin": {
              "type": "string"
            },
            "verifyURL": {
              "type": "string"
            }
          }
        },
        "connectionHostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connectionOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "externalAuthNamespace": {
      "type": "string"
    },
    "authClientNamespaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authIngress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentName": {
          "type": "string"
        },
        "parentNamespace": {
          "type": "string"
        },
        "sectionName": {
          "type": "string"
        },
        "additionalHostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authReplicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "authTolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "phase",
    "development",
    "bootstrapRevision",
    "tenant",
    "databaseInstances",
    "publicOrigin",
    "adminOrigin",
    "hostname",
    "tlsSecret",
    "gatewayClass",
    "dnsResolver",
    "tenants",
    "storage",
    "resources",
    "images",
    "secrets"
  ]
}
